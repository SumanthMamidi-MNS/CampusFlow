# CampusFlow production environment — copy to `.env` next to
# docker-compose.prod.yml:
#
#     cp .env.production.example .env
#
# Compose reads `.env` for ${VARS} interpolation; the backend receives the same
# values through `environment:`. Both required secrets below are enforced:
# compose refuses to start without them, and the application refuses to start
# when DEBUG=false and the JWT secret is still the shipped placeholder (ADR-015).

# ── Required secrets ─────────────────────────────────────────────────────────
# Generate both with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=campusflow
POSTGRES_DB=campusflow
# Loopback-only maintenance ports (psql, pg_dump, health checks). The defaults
# deliberately avoid the dev stack's 5432/6379/8000 so both stacks can run on
# one machine.
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8001
FRONTEND_PORT=8080

# ── Application ──────────────────────────────────────────────────────────────
# The deployment origin(s). Same-origin by default because the proxy serves the
# SPA and the API from one host — add a second entry only if a second origin
# exists, and put the https origin here once a domain is configured.
CORS_ORIGINS=["http://localhost"]
INSTITUTION_NAME="CampusFlow"
INSTITUTION_TIMEZONE="UTC"
# console = mail is written to the container output. Set to smtp and supply a
# relay through your own infrastructure for real delivery (no relay is bundled).
EMAIL_BACKEND=console

# ── Sandboxed code execution (Piston) ────────────────────────────────────────
CODE_RUNNER_ENABLED=true
CODE_RUNNER_PYTHON_VERSION=3.10.0
CODE_RUN_DEFAULT_TIMEOUT_MS=5000
CODE_RUN_MAX_TIMEOUT_MS=10000
# Hard memory ceiling in KB, enforced by Piston's sandbox (the container runs
# privileged so cgroup limits apply — D-5). 0 disables the ceiling.
CODE_RUN_MEMORY_LIMIT_KB=131072

# ── Assessment integrity data ────────────────────────────────────────────────
# Camera evidence stills are personal data. The daily retention job erases the
# image once a frame is older than this many days; the event entry itself (what
# happened, when) is kept for review. 0 keeps images until erased by hand.
# Candidates are told this window in the assessment brief.
PROCTORING_EVIDENCE_RETENTION_DAYS=90

# ── Backups ──────────────────────────────────────────────────────────────────
# Daily `pg_dump -Fc` into the `backups` volume; dumps older than this are
# pruned. BACKUP_START_HOUR is the local hour of the first nightly dump.
BACKUP_KEEP_DAYS=14
BACKUP_START_HOUR=2
