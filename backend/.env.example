# CampusFlow backend environment template.
#
# Copy to `.env` (or just run the launcher, which does it for you) and adjust.
# Variable names map directly to Settings fields — there is no prefix, so
# `DEBUG` configures `Settings.debug`.
#
#   PowerShell:  Copy-Item .env.example .env
#   cmd:         copy .env.example .env
#
# During local development DEBUG=true allows the shipped placeholder secret.
# For any non-debug deployment you MUST set a strong, unique JWT_SECRET_KEY,
# or the application will refuse to start.

DEBUG=True
# Log every SQL statement. Deliberately separate from DEBUG so the console stays
# readable during development and demonstrations.
DB_ECHO=False

DATABASE_URL=postgresql+asyncpg://campusflow:campusflow@localhost:5432/campusflow
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON array of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# console | smtp — the `smtp` backend delivers to the Mailpit catcher
# included in docker-compose (SMTP on localhost:1025, web UI on :8025).
EMAIL_BACKEND=smtp

INSTITUTION_NAME="CampusFlow"
INSTITUTION_TIMEZONE="UTC"

# Authentication rate limiting (per client IP).
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Sandboxed code execution (see campusflow.bedrock.runner).
#   CODE_RUNNER_BACKEND: "piston" (self-hosted sidecar) or "none" to disable.
#   Student code is never executed inside the API process.
CODE_RUNNER_ENABLED=true
CODE_RUNNER_BACKEND=piston
CODE_RUNNER_URL=http://localhost:2000
CODE_RUNNER_PYTHON_VERSION=3.10.0
CODE_RUNNER_CLIENT_TIMEOUT_SECONDS=20
CODE_RUN_MAX_CONCURRENCY=4
CODE_RUN_DEFAULT_TIMEOUT_MS=5000
CODE_RUN_MAX_TIMEOUT_MS=10000
CODE_RUN_DEFAULT_MEMORY_KB=131072
CODE_RUN_MAX_OUTPUT_BYTES=65536
# Hard memory ceiling forwarded to the sandbox, in KB. 0 = let the sandbox use
# its own default. Only set a number on hosts where the sandbox can enforce a
# cgroup memory cap: where it cannot, requesting one makes isolate kill the
# process instead of running it.
CODE_RUN_MEMORY_LIMIT_KB=0

# Camera evidence stills are personal data. The retention job
# (scripts/purge_proctoring_evidence.py, run daily by the production stack)
# erases the image once a frame is older than this many days; the event entry
# itself is kept. 0 keeps images until erased by hand. Disclosed to candidates.
PROCTORING_EVIDENCE_RETENTION_DAYS=90
